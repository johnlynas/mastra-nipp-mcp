{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@prisma-gen/*": ["./prisma/generated/prisma/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "prisma/generated/**/*.ts", "vitest.config.ts"]
}
