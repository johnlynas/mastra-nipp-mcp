# NIPP portal base URL (no trailing slash)
PORTAL_BASE_URL=http://localhost:3000

# BetterAuth credentials used by the MCP server to obtain a bearer token.
PORTAL_EMAIL=
PORTAL_PASSWORD=

# Default organization context sent as x-org-id when a tool call does not
# supply orgId explicitly (the portal requires org context for most routes).
PORTAL_DEFAULT_ORG_ID=

# Mastra dev server port (default 4111)
PORT=4112

# ── Per-request user authz (phase 1) — shared session verification ──
# PostgreSQL connection string for the portal DB (same as the agent's .env).
DATABASE_URL=
# BetterAuth base URL of the portal.
BETTER_AUTH_URL=http://localhost:3000
# MUST equal the portal's BETTER_AUTH_SECRET (session tokens are verified with it).
BETTER_AUTH_SECRET=
# Platform org id — membership here makes a caller a platform admin.
PLATFORM_ORG_ID=
# Allow the legacy service-account session when a tool call has no caller
# token (existing non-agent MCP clients). 0 = reject such calls outright.
MCP_ALLOW_SERVICE_FALLBACK=1
