# NIPP portal base URL (no trailing slash)
PORTAL_BASE_URL=http://localhost:3000

# BetterAuth credentials used by the MCP server to obtain a bearer token.
PORTAL_EMAIL=
PORTAL_PASSWORD=

# Default organization context sent as x-org-id when a tool call does not
# supply orgId explicitly (the portal requires org context for most routes).
PORTAL_DEFAULT_ORG_ID=

# Mastra dev server port (default 4111)
PORT=4112

# ── Per-request user authz (phase 1) — shared session verification ──
# PostgreSQL connection string for the portal DB (same as the agent's .env).
DATABASE_URL=
# BetterAuth base URL of the portal.
BETTER_AUTH_URL=http://localhost:3000
# MUST equal the portal's BETTER_AUTH_SECRET (session tokens are verified with it).
BETTER_AUTH_SECRET=
# Platform org id — membership here makes a caller a platform admin.
PLATFORM_ORG_ID=
# Allow the legacy service-account session when a tool call has no caller
# token (existing non-agent MCP clients). Phase 3: DEFAULT OFF — unauthenticated
# calls are rejected with 401 and the super-admin session is unreachable.
# Set to 1 to restore the pre-phase-3 behavior for Studio / ad-hoc scripts.
MCP_ALLOW_SERVICE_FALLBACK=0
# Enforce the server-side admin scope gate: /api/admin/* tools return 403 for
# verified callers who are not platform admins (before any portal call).
# 0 = disable (phase 1 behavior — portal RBAC decides). Default on.
MCP_ENFORCE_SCOPE_GATE=1

# ── Audit logging (phase 3) ──
# JSON-lines audit log destination (one line per tool call: ts, userId, toolId,
# scope, orgId, status, latencyMs). Defaults to ./audit/mcp-audit.log.
MCP_AUDIT_LOG_FILE=./audit/mcp-audit.log
